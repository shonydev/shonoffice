<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ShonOffice.Domain</RootNamespace>
  </PropertyGroup>

  <!--
    Hexagonal architecture rule: the Domain doesn't depend on anything
    external (not Open XML SDK, not Avalonia, not the Rust engine). It only
    defines the document model and the ports (interfaces) that
    infrastructure implements.
  -->

</Project>
