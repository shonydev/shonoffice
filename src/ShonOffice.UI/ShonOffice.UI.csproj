<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ShonOffice.UI</RootNamespace>
  </PropertyGroup>

  <!--
    Primer adaptador de entrada en C# (Avalonia + MVVM-lite en code-behind,
    sin XAML, para que el build no dependa del compilador de markup). Para
    .docx, reemplaza a la GUI en Rust/egui (src/main.rs): llama a los mismos
    casos de uso de ShonOffice.Application y renderiza el formato real que
    entrega ShonOffice.Infra.OpenXml (negrita, color, tamaño, alineación,
    encabezados), en vez de solo texto plano.
  -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShonOffice.Domain\ShonOffice.Domain.csproj" />
    <ProjectReference Include="..\ShonOffice.Application\ShonOffice.Application.csproj" />
    <ProjectReference Include="..\ShonOffice.Infra.OpenXml\ShonOffice.Infra.OpenXml.csproj" />
  </ItemGroup>

</Project>
