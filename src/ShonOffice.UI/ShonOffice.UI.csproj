<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ShonOffice.UI</RootNamespace>
  </PropertyGroup>

  <!--
    First input adapter in C# (Avalonia + MVVM-lite in code-behind, no
    XAML, so the build doesn't depend on the markup compiler). For .docx,
    it replaces the Rust/egui GUI (src/main.rs): it calls the same use
    cases from ShonOffice.Application and renders the real formatting
    delivered by ShonOffice.Infra.OpenXml (bold, color, size, alignment,
    headings), instead of just plain text.
  -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShonOffice.Domain\ShonOffice.Domain.csproj" />
    <ProjectReference Include="..\ShonOffice.Application\ShonOffice.Application.csproj" />
    <ProjectReference Include="..\ShonOffice.Infra.OpenXml\ShonOffice.Infra.OpenXml.csproj" />
  </ItemGroup>

</Project>
